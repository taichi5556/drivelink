cd ~/projects/drivelink
cursor .
# → Cursorがdrivelinkを開く

# バージョンアップ
sed -i '' 's/^version: 1.0.2+8/version: 1.0.3+9/' ~/projects/drivelink/pubspec.yaml

# iOSビルド
cd ~/projects/drivelink && flutter build ipa --release

# Androidビルド
cd ~/projects/drivelink && flutter build appbundle --release

# 実機テスト
flutter run -d 00008150-001865A41E38401C --release

# キャッシュ削除
rm -rf ~/Library/Developer/Xcode/DerivedData/*
flutter clean
rm -rf ~/.gradle/caches/
